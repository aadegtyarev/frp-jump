[Unit]
Description=frp-jump server (control-plane + relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Set FRP_JUMP_RELAY_PUBLIC_ADDR (required) and any other FRP_JUMP_* overrides here.
EnvironmentFile=-/etc/frp-jump/server.env
ExecStart=/usr/local/bin/frp-jump-server run
Restart=on-failure
RestartSec=5
User=frp-jump
Group=frp-jump
# Only needed if you bind the WebUI/API to a privileged port (<1024).
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
