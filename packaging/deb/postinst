#!/bin/sh
# postinst for frp-jump-client. build.sh copies this into DEBIAN/postinst.
set -e

PACKAGE=frp-jump-client
SITE_PACKAGES=/opt/frp-jump-client/site-packages

# Remove every *.dist-info under the bundled site-packages that this package
# does not ship. dpkg only replaces files it owns; metadata written there by
# anything else (a hand-run `pip install --target`, a dev build copied over)
# survives every upgrade, and importlib.metadata may then report its stale
# version instead of the packaged one -- the agent sent 0.3.15.dev0 as its
# agent_version on 0.3.19 for exactly this reason.
remove_unowned_dist_info() {
    # An empty or failed listing would make every dist-info look unowned;
    # skip the cleanup rather than delete the packaged metadata too.
    owned=$(dpkg-query -L "$PACKAGE" 2>/dev/null) || return 0
    [ -n "$owned" ] || return 0
    for path in "${DPKG_ROOT:-}$SITE_PACKAGES"/*.dist-info; do
        [ -d "$path" ] || continue
        name=${path##*/}
        if ! printf '%s\n' "$owned" | grep -qxF "$SITE_PACKAGES/$name"; then
            echo "$PACKAGE: removing stale $SITE_PACKAGES/$name" >&2
            rm -rf "$path"
        fi
    done
}

# The system unit, then every user's: an `install-service --user` unit lives
# in that user's own systemd manager, which the system `systemctl` can't see,
# so it is reached through runuser with the user's runtime dir.
restart_agents_script() {
    cat <<EOF
systemctl try-restart $PACKAGE.service
for dir in ${DPKG_ROOT:-}/run/user/*; do
    [ -S "\$dir/systemd/private" ] || continue
    user=\$(stat -c %U "\$dir") || continue
    runuser -u "\$user" -- env XDG_RUNTIME_DIR="\$dir" systemctl --user try-restart $PACKAGE.service
done
EOF
}

if [ "$1" = "configure" ]; then
    remove_unowned_dist_info
    systemctl daemon-reload || true
    # With a previously configured version (an upgrade, but also a reconfigure
    # or `dpkg --configure -a`, where a restart is harmless), restart the
    # agents -- the system one and every user's -- only if they are running
    # now, so they pick up the new code; never start a stopped or
    # never-installed one.
    #
    # The restart drops every tunnel on the machine, possibly including the
    # ssh session this very `apt upgrade` runs in. So on a live systemd host
    # it is handed to a transient timer and happens ~30 s later, after apt
    # has finished, instead of killing apt mid-run. Without systemd (chroots,
    # image builds) the synchronous fallback runs; deb-systemd-invoke there
    # also honours policy-rc.d.
    if [ -n "$2" ]; then
        if [ -d "${DPKG_ROOT:-}/run/systemd/system" ] \
            && command -v systemd-run >/dev/null 2>&1; then
            systemd-run --quiet --no-block --on-active=30 \
                /bin/sh -c "$(restart_agents_script)" || true
        elif command -v deb-systemd-invoke >/dev/null 2>&1; then
            deb-systemd-invoke try-restart "$PACKAGE.service" || true
        else
            systemctl try-restart "$PACKAGE.service" || true
        fi
    fi
fi
